# Copy to server/.env for local backend development. Never commit real secrets.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/subscription_optimizer
# Optional API integration-test database. Must be a disposable database ending in _phase13b_test.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/subscription_optimizer_phase13b_test
JWT_SECRET=replace-with-a-long-random-local-development-secret
JWT_EXPIRES_IN=1h
# Optional one-time bootstrap values for the first PLATFORM_ADMIN account.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
3
